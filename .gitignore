# ========================
# TestMaster AI — .gitignore
# ========================

# Context & internal docs
context.md

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.env
.env.*
!.env.example

# Alembic
alembic/versions/*.pyc

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# Logs
*.log
logs/

# Database
*.sqlite3
*.db

# Playwright
playwright-workspace/node_modules/
playwright-workspace/test-results/
playwright-workspace/playwright-report/
playwright-workspace/reports/
playwright-workspace/tests/
playwright-workspace/.env
playwright-workspace/credentials.txt
!playwright-workspace/.env.example
!playwright-workspace/credentials.txt.example

tests/generated/

# Node / Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/build/
*.local

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Docker (for later)
*.env.docker

# Misc
*.bak
*.tmp
.cache/
